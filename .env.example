# Copy to `.env` and fill in keys. Never commit the filled file.

# ============================================================================
# LLM — Gemini 3 for screening, DeepSeek if Gemini fails
# ============================================================================
# Precedence per stage: SCREEN_PROVIDER / DRAFT_PROVIDER -> LLM_PROVIDER
# Stages: screen (every candidate) and draft (only with `run --draft-top N`)

LLM_PROVIDER=gemini
SCREEN_PROVIDER=gemini
DRAFT_PROVIDER=gemini

# Gemini 3 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
SCREEN_MODEL=gemini-3.5-flash-lite
DRAFT_MODEL=gemini-3.6-flash

# DeepSeek backup (https://platform.deepseek.com -> API keys)
# Also accepts DEEP_SEEK_API_KEY as an alias.
FALLBACK_PROVIDER=deepseek
FALLBACK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# --- optional other providers ---
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# LLM_BASE_URL=
# OLLAMA_HOST=http://localhost:11434

# DeepSeek-only (no Gemini). Profile step needs a .txt/.md resume, not PDF.
# LLM_PROVIDER=deepseek
# SCREEN_PROVIDER=deepseek
# DRAFT_PROVIDER=deepseek
# SCREEN_MODEL=deepseek-chat
# DRAFT_MODEL=deepseek-chat

# ============================================================================
# Email — Gmail App Password (16 chars, no spaces), not your login password
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_TO=you@gmail.com

# ============================================================================
# Hosted deploy only (Render + Upstash). Not needed on your laptop.
# ============================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# STORE_BACKEND=redis
RUN_TOKEN=
# PROFILE_JSON={"name":"..."}
