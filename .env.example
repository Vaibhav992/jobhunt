# Copy to .env and fill in. .env is gitignored; never commit real keys.
#   cp .env.example .env
#
# Nothing here is required for the offline dry run:
#   python -m jobhunt run --mock --scorer keyword

# ---------------------------------------------------------------------------
# Which provider handles which stage.
#
# LLM_PROVIDER sets both stages. SCREEN_PROVIDER / DRAFT_PROVIDER override it
# per stage, which is the whole point: screening is high-volume and wants the
# cheapest decent model, drafting is low-volume and wants the best one.
#
# Valid values: anthropic | gemini | groq | openai-compatible | ollama
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic
# SCREEN_PROVIDER=groq
# DRAFT_PROVIDER=anthropic

# Model IDs. Omit to accept the per-provider defaults in providers.py.
SCREEN_MODEL=claude-haiku-4-5-20251001
DRAFT_MODEL=claude-sonnet-5

# --- keys: set only the ones for providers you actually use ----------------
ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...                          # aistudio.google.com/apikey
# GROQ_API_KEY=gsk_...                        # console.groq.com/keys

# For LLM_PROVIDER=openai-compatible (Together, OpenRouter, vLLM, ...).
# Reads GROQ_API_KEY as its bearer token; point the base URL wherever.
# LLM_BASE_URL=https://openrouter.ai/api/v1

# For LLM_PROVIDER=ollama — fully local, no key at all.
# OLLAMA_HOST=http://localhost:11434

# ---------------------------------------------------------------------------
# Email (only needed for `run --send`)
# Gmail: create an App Password at myaccount.google.com/apppasswords.
# Your normal password will NOT work once 2FA is on.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_TO=you@gmail.com
