# jobhunt configuration by environment variable. Copy to `.env` for local runs
# (the CLI reads .env automatically). On Render, set these in the dashboard
# instead — see render.yaml. Never commit the filled-in .env; it holds secrets.

# ============================================================================
# LLM — the recommended cheap setup is DeepSeek for screening.
# ============================================================================
# Provider precedence per stage: <STAGE>_PROVIDER -> LLM_PROVIDER -> anthropic.
# Stages are "screen" (cheap, every candidate) and "draft" (only with
# `run --draft-top N`). List-only mode uses just the screen stage.
LLM_PROVIDER=gemini
SCREEN_PROVIDER=gemini
SCREEN_MODEL=gemini-2.0-flash
# If Gemini errors (quota, 429, outage), the same call retries on DeepSeek.
FALLBACK_PROVIDER=deepseek
FALLBACK_MODEL=deepseek-chat

# DeepSeek key (https://platform.deepseek.com -> API keys). Its prompt-cache
# makes the repeated profile prefix nearly free across a batch of screens.
DEEPSEEK_API_KEY=

# --- other providers (optional; only the one you point a stage at is used) ---
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# LLM_BASE_URL=            # override for any OpenAI-compatible endpoint
# OLLAMA_HOST=http://localhost:11434
# DRAFT_PROVIDER=deepseek  # only matters if you use `run --draft-top N`
# DRAFT_MODEL=deepseek-chat

# ============================================================================
# Email — Gmail needs an App Password (Google Account -> Security -> App
# passwords), NOT your normal login password.
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_TO=you@gmail.com

# ============================================================================
# Seen-store / dedupe. Local runs use seen.json on disk automatically.
# On Render the disk is wiped on every spin-down, so point at Upstash Redis
# (https://upstash.com -> create a Redis DB -> REST API section). When both
# vars below are set, the Redis backend is selected automatically.
# ============================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# STORE_BACKEND=redis      # force a backend; usually leave unset (auto-detects)

# ============================================================================
# Web service (Render). Shared secret the cron pinger sends to authorize /run.
# Generate one: `python -c "import secrets; print(secrets.token_urlsafe(32))"`
# ============================================================================
RUN_TOKEN=

# profile.json is gitignored, so on Render it arrives as this env var and is
# written to disk at boot. Paste the ONE-LINE contents of your local
# profile.json here. Not needed locally (the file is already on disk).
# PROFILE_JSON={"role":"...","skills":[...]}
